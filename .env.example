# Copy to .env and fill in. Never commit the real file.

SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# IMPORTANT — pick the right host.
# On the Supabase free tier, db.<ref>.supabase.co resolves to IPv6 ONLY. On an
# IPv4-only network it fails with "No route to host". Use the session pooler
# instead, and note the username is tenant-qualified (postgres.<ref>).
SUPABASE_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=

# Only needed if the backend ever writes through PostgREST rather than JDBC.
SUPABASE_SERVICE_KEY=

# Salt for hashing session identifiers. Must be long and random in production —
# raw IPs are never stored, only salted hashes.
EVENT_SESSION_SALT=change-me-to-a-long-random-string

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:4200

API_BASE_URL=http://localhost:8080/api/v1
