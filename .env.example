# Copy to .env and fill in. Never commit the real file.

# Supabase Postgres (Spring Boot connects with these)
SUPABASE_DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_SERVICE_KEY=

# Salt for hashing session identifiers before they are stored
EVENT_SESSION_SALT=change-me

# Where the Angular app expects the API
API_BASE_URL=http://localhost:8080/api/v1
